# ============================================================
# autoboost-backend-core — environment variables (example)
# Copiar a `.env` y ajustar valores. NUNCA commitear `.env`.
# Todas las vars son validadas por Joi en
# src/shared/config/validation.schema.ts
# ============================================================

# -------- App --------
NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=debug               # debug | info | warn | error

# -------- Database (Postgres) --------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoboost-core
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false                  # true en entornos con SSL obligatorio (RDS, etc.)

# -------- Auth (JWT vía autoboost-backend-auth) --------
# Este servicio NO emite tokens. Solo valida los emitidos por autoboost-backend-auth (RS256).
# NO uses JWT_ACCESS_SECRET / JWT_REFRESH_SECRET del auth aquí (modelo HS256 obsoleto).
# Guía: docs/AUTH-CONSUMER.md | docs/INTEGRATION.md | docs/RS256-JWKS.md
#
# JWT_MODE:
#   mock   → dev local sin auth. Headers X-User-Id + X-Roles (permisos core, ver API.md).
#   jwks   → producción/staging. Bearer accessToken + JWKS del auth.
#   static → fallback (PEM público). Sin rotación automática.
JWT_MODE=mock

# Solo si JWT_MODE=jwks (URL en la RAÍZ del host auth, SIN prefijo /api)
# Ejemplo Railway:
# JWT_JWKS_URL=https://boost-auto-auth-backend-production.up.railway.app/.well-known/jwks.json
# JWT_JWKS_URL=

# Solo si JWT_MODE=static (PEM público RSA). En jwks: NO definir esta variable en Railway.
# JWT_PUBLIC_KEY=

JWT_ISSUER=autoboost-auth
JWT_AUDIENCE=autoboost-core

# -------- Impuestos --------
# Tasa aplicada por el servidor a cada línea de orden y cotización.
# Fracción, no porcentaje: 0.16 = 16%. El cliente ya no envía el impuesto.
TAX_RATE=0.16

# -------- Polar.sh (opcional) --------
POLAR_ENABLED=false
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
# POLAR_PRODUCT_ID=
# POLAR_SUCCESS_URL=
# POLAR_CANCEL_URL=
# POLAR_CURRENCY=mxn

# -------- Skydropx (opcional) --------
SKYDROPX_ENABLED=false
# SKYDROPX_CLIENT_ID=
# SKYDROPX_CLIENT_SECRET=
# SKYDROPX_SERVER=sandbox
# SKYDROPX_WEBHOOK_SECRET=
# SKYDROPX_ORIGIN_NAME=
# SKYDROPX_ORIGIN_STREET1=
# SKYDROPX_ORIGIN_POSTAL_CODE=
# SKYDROPX_ORIGIN_AREA_LEVEL1=
# SKYDROPX_ORIGIN_AREA_LEVEL2=
# SKYDROPX_ORIGIN_PHONE=

# -------- Rough Country stock feed (opcional) --------
# Importa stock desde el feed del proveedor a las 11:00 y 15:00 (hora de Mexico).
ROUGH_COUNTRY_SYNC_ENABLED=false
# ROUGH_COUNTRY_FEED_URL=https://feeds.roughcountry.com/jobber_pc3.xlsx
# Ids de suppliers.provider_branch. Son BIGINT GENERATED ALWAYS AS IDENTITY,
# asi que cambian por ambiente: consultalos con
#   SELECT id, branch_name, city FROM suppliers.provider_branch;
# NV = Sparks, Nevada. TN = Dyersburg, Tennessee.
# ROUGH_COUNTRY_BRANCH_NV_ID=
# ROUGH_COUNTRY_BRANCH_TN_ID=
# ROUGH_COUNTRY_SYNC_TZ=America/Mexico_City
