# ============================================================
# autoboost-backend-core â€” environment variables (example)
# Copiar a `.env` y ajustar valores. NUNCA commitear `.env`.
# Todas las vars son validadas por Joi en
# src/shared/config/validation.schema.ts
# ============================================================

# -------- App --------
NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=debug               # debug | info | warn | error

# -------- Database (Postgres) --------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoboost-core
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false                  # true en entornos con SSL obligatorio (RDS, etc.)

# -------- Auth (JWT vÃ­a autoboost-auth) --------
# JWT_MODE controla cÃ³mo se valida el token:
#   mock   â†’ desarrollo local. Lee X-User-Id y X-Roles (CSV) de los headers.
#            No requiere JWT_JWKS_URL ni JWT_PUBLIC_KEY.
#   jwks   â†’ producciÃ³n. Requiere JWT_JWKS_URL apuntando al endpoint de
#            autoboost-auth (rotaciÃ³n de claves automÃ¡tica).
#   static â†’ fallback. Requiere JWT_PUBLIC_KEY pegada inline (PEM o secret).
JWT_MODE=mock

# SÃ³lo se usa cuando JWT_MODE=jwks
JWT_JWKS_URL=

# SÃ³lo se usa cuando JWT_MODE=static
JWT_PUBLIC_KEY=

# ValidaciÃ³n de claims emitidos por autoboost-auth
JWT_ISSUER=autoboost-auth
JWT_AUDIENCE=autoboost-core

# -------- Rough Country stock feed (opcional) --------
# Importa stock desde el feed del proveedor a las 11:00 y 15:00 (hora de Mexico).
ROUGH_COUNTRY_SYNC_ENABLED=false
# ROUGH_COUNTRY_FEED_URL=https://feeds.roughcountry.com/jobber_pc3.xlsx
# Ids de suppliers.provider_branch. Son BIGINT GENERATED ALWAYS AS IDENTITY,
# asi que cambian por ambiente: consultalos con
#   SELECT id, branch_name, city FROM suppliers.provider_branch;
# NV = Sparks, Nevada. TN = Dyersburg, Tennessee.
# ROUGH_COUNTRY_BRANCH_NV_ID=
# ROUGH_COUNTRY_BRANCH_TN_ID=
# ROUGH_COUNTRY_SYNC_TZ=America/Mexico_City
