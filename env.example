# ============================================================
# autoboost-backend-core — environment variables (example)
# Copiar a `.env` y ajustar valores. NUNCA commitear `.env`.
# Todas las vars son validadas por Joi en
# src/shared/config/validation.schema.ts
# ============================================================

# -------- App --------
NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=debug               # debug | info | warn | error

# -------- Database (Postgres) --------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoboost-core
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false                  # true en entornos con SSL obligatorio (RDS, etc.)

# -------- Auth (JWT vía autoboost-auth) --------
# JWT_MODE controla cómo se valida el token:
#   mock   → desarrollo local. Lee X-User-Id y X-Roles (CSV) de los headers.
#            No requiere JWT_JWKS_URL ni JWT_PUBLIC_KEY.
#   jwks   → producción. Requiere JWT_JWKS_URL apuntando al endpoint de
#            autoboost-auth (rotación de claves automática).
#   static → fallback. Requiere JWT_PUBLIC_KEY pegada inline (PEM o secret).
JWT_MODE=mock

# Sólo se usa cuando JWT_MODE=jwks
JWT_JWKS_URL=

# Sólo se usa cuando JWT_MODE=static
JWT_PUBLIC_KEY=

# Validación de claims emitidos por autoboost-auth
JWT_ISSUER=autoboost-auth
JWT_AUDIENCE=autoboost-core
